generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model bank_accounts {
  id                  Int                         @id @default(autoincrement())
  bank_name           String                      @db.VarChar(255)
  account_number      String                      @unique(map: "account_number") @db.VarChar(50)
  ifsc_code           String?                     @db.VarChar(20)
  account_holder_name String?                     @db.VarChar(255)
  account_type        bank_accounts_account_type? @default(CURRENT)
  is_active           Boolean?                    @default(true)
  created_at          DateTime?                   @default(now()) @db.Timestamp(0)
  updated_at          DateTime?                   @default(now()) @db.Timestamp(0)
  customer_payments   customer_payments[]
}

model bom {
  id          Int         @id @default(autoincrement())
  item_code   String?     @db.VarChar(120)
  drawing_no  String?     @db.VarChar(120)
  description String?     @db.Text
  uom         String?     @db.VarChar(20)
  item_group  String?     @db.VarChar(100)
  is_active   Boolean?    @default(true)
  created_at  DateTime?   @default(now()) @db.Timestamp(0)
  updated_at  DateTime?   @default(now()) @db.Timestamp(0)
  bom_items   bom_items[]

  @@index([drawing_no], map: "idx_drawing_no")
  @@index([item_code], map: "idx_item_code")
}

model bom_approval_history {
  id             Int                         @id @default(autoincrement())
  sales_order_id Int
  user_id        Int
  action         bom_approval_history_action
  remarks        String?                     @db.Text
  created_at     DateTime?                   @default(now()) @db.Timestamp(0)
  sales_orders   sales_orders                @relation(fields: [sales_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bom_approval_history_ibfk_1")
  users          users                       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bom_approval_history_ibfk_2")

  @@index([sales_order_id], map: "sales_order_id")
  @@index([user_id], map: "user_id")
}

model bom_items {
  id             Int       @id @default(autoincrement())
  bom_id         Int
  component_code String    @db.VarChar(120)
  quantity       Decimal   @default(0.0000) @db.Decimal(12, 4)
  uom            String?   @db.VarChar(20)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  bom            bom       @relation(fields: [bom_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bom_items_ibfk_1")

  @@index([bom_id], map: "idx_bom_id")
  @@index([component_code], map: "idx_component_code")
}

model companies {
  id                 Int                  @id @default(autoincrement())
  company_name       String               @db.VarChar(255)
  company_code       String               @unique(map: "company_code") @db.VarChar(32)
  customer_type      String?              @default("REGULAR") @db.VarChar(50)
  status             companies_status?    @default(ACTIVE)
  gstin              String?              @db.VarChar(20)
  cin                String?              @db.VarChar(40)
  pan                String?              @db.VarChar(20)
  payment_terms      String?              @db.VarChar(255)
  credit_days        Int?
  currency           String?              @default("INR") @db.VarChar(10)
  freight_terms      String?              @db.VarChar(255)
  packing_forwarding String?              @db.VarChar(255)
  insurance_terms    String?              @db.VarChar(255)
  created_at         DateTime?            @default(now()) @db.Timestamp(0)
  company_addresses  company_addresses[]
  contacts           contacts[]
  customer_ledger    customer_ledger[]
  customer_payments  customer_payments[]
  customer_pos       customer_pos[]
  delivery_challans  delivery_challans[]
  payment_receipts   payment_receipts[]
  quotation_requests quotation_requests[]
  sales_orders       sales_orders[]
  shipment_orders    shipment_orders[]
}

model company_addresses {
  id           Int                            @id @default(autoincrement())
  company_id   Int
  address_type company_addresses_address_type
  line1        String                         @db.VarChar(255)
  line2        String?                        @db.VarChar(255)
  city         String?                        @db.VarChar(120)
  state        String?                        @db.VarChar(120)
  pincode      String?                        @db.VarChar(20)
  country      String?                        @default("India") @db.VarChar(120)
  created_at   DateTime?                      @default(now()) @db.Timestamp(0)
  companies    companies                      @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "company_addresses_ibfk_1")

  @@index([company_id], map: "company_id")
}

model contacts {
  id           Int                    @id @default(autoincrement())
  company_id   Int
  name         String?                @db.VarChar(120)
  email        String?                @db.VarChar(255)
  phone        String?                @db.VarChar(30)
  designation  String?                @db.VarChar(120)
  contact_type contacts_contact_type? @default(PRIMARY)
  status       contacts_status?       @default(ACTIVE)
  created_at   DateTime?              @default(now()) @db.Timestamp(0)
  updated_at   DateTime?              @default(now()) @db.Timestamp(0)
  companies    companies              @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contacts_ibfk_1")

  @@index([company_id], map: "company_id")
}

model customer_drawings {
  id                 Int                       @id @default(autoincrement())
  public_id          String?                   @unique(map: "public_id") @db.VarChar(100)
  project_name       String?                   @db.VarChar(255)
  client_name        String?                   @db.VarChar(255)
  drawing_no         String                    @db.VarChar(120)
  revision           String?                   @db.VarChar(50)
  qty                Int?                      @default(1)
  description        String?                   @db.Text
  drawing_type       String?                   @default("Part") @db.VarChar(50)
  hsn_code           String?                   @db.VarChar(20)
  delivery_date      DateTime?                 @db.Date
  file_path          String                    @db.VarChar(500)
  file_type          String?                   @db.VarChar(20)
  remarks            String?                   @db.Text
  type               String?                   @default("Customer") @db.VarChar(50)
  purpose            String?                   @default("Reference Only") @db.VarChar(50)
  uploaded_by        String?                   @db.VarChar(120)
  status             customer_drawings_status? @default(PENDING)
  created_at         DateTime?                 @default(now()) @db.Timestamp(0)
  updated_at         DateTime?                 @default(now()) @db.Timestamp(0)
  contact_person     String?                   @db.VarChar(255)
  email              String?                   @db.VarChar(255)
  phone              String?                   @db.VarChar(20)
  customer_type      String?                   @db.VarChar(50)
  gstin              String?                   @db.VarChar(50)
  city               String?                   @db.VarChar(100)
  state              String?                   @db.VarChar(100)
  billing_address    String?                   @db.Text
  shipping_address   String?                   @db.Text
  shared_with_design Boolean?                  @default(false)
  shared_at          DateTime?                 @db.Timestamp(0)
  excel_path         String?                   @db.VarChar(255)
  zip_path           String?                   @db.VarChar(255)
}

model customer_ledger {
  id                 Int                                @id @default(autoincrement())
  customer_id        Int
  reference_doc_id   Int?
  reference_doc_type customer_ledger_reference_doc_type
  transaction_type   customer_ledger_transaction_type
  amount             Decimal                            @db.Decimal(14, 2)
  description        String?                            @db.Text
  ledger_date        DateTime                           @db.Date
  created_at         DateTime?                          @default(now()) @db.Timestamp(0)
  companies          companies                          @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_ledger_ibfk_1")

  @@index([customer_id, ledger_date], map: "idx_customer_date")
  @@index([reference_doc_id, reference_doc_type], map: "idx_reference")
}

model customer_payments {
  id                  Int                                   @id @default(autoincrement())
  payment_receipt_no  String?                               @unique(map: "payment_receipt_no") @db.VarChar(100)
  invoice_id          Int?
  sales_order_id      Int?
  sales_order_source  customer_payments_sales_order_source? @default(SALES_ORDER)
  customer_id         Int
  payment_amount      Decimal                               @db.Decimal(14, 2)
  payment_date        DateTime                              @db.Date
  payment_mode        customer_payments_payment_mode
  transaction_ref_no  String?                               @db.VarChar(255)
  bank_account_id     Int?
  manual_bank_account String?                               @db.VarChar(255)
  remarks             String?                               @db.Text
  upi_app             String?                               @db.VarChar(50)
  upi_transaction_id  String?                               @db.VarChar(255)
  cheque_number       String?                               @db.VarChar(100)
  cheque_bank_name    String?                               @db.VarChar(255)
  cheque_date         DateTime?                             @db.Date
  card_type           String?                               @db.VarChar(50)
  card_last_4_digits  String?                               @db.VarChar(4)
  authorization_code  String?                               @db.VarChar(255)
  status              customer_payments_status?             @default(CONFIRMED)
  created_by          Int?
  created_at          DateTime?                             @default(now()) @db.Timestamp(0)
  updated_at          DateTime?                             @default(now()) @db.Timestamp(0)
  companies           companies                             @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_payments_ibfk_1")
  bank_accounts       bank_accounts?                        @relation(fields: [bank_account_id], references: [id], onUpdate: NoAction, map: "customer_payments_ibfk_2")
  users               users?                                @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "customer_payments_ibfk_3")
  payment_receipts    payment_receipts[]

  @@index([bank_account_id], map: "bank_account_id")
  @@index([created_by], map: "created_by")
  @@index([customer_id, payment_date], map: "idx_customer_date")
  @@index([status], map: "idx_status")
}

model customer_po_item_subassemblies {
  id                Int               @id @default(autoincrement())
  po_item_id        Int
  drawing_no        String?           @db.VarChar(255)
  description       String?           @db.Text
  quantity          Decimal?          @db.Decimal(15, 3)
  unit              String?           @db.VarChar(50)
  rate              Decimal?          @db.Decimal(15, 2)
  created_at        DateTime?         @default(now()) @db.Timestamp(0)
  customer_po_items customer_po_items @relation(fields: [po_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_po_item_subassemblies_ibfk_1")

  @@index([po_item_id], map: "po_item_id")
}

model customer_po_items {
  id                             Int                              @id @default(autoincrement())
  customer_po_id                 Int
  item_code                      String?                          @db.VarChar(120)
  description                    String                           @db.Text
  hsn_code                       String?                          @db.VarChar(50)
  drawing_no                     String?                          @db.VarChar(120)
  revision_no                    String?                          @db.VarChar(50)
  quantity                       Decimal?                         @default(0.000) @db.Decimal(12, 3)
  unit                           String?                          @default("NOS") @db.VarChar(20)
  rate                           Decimal?                         @default(0.00) @db.Decimal(12, 2)
  basic_amount                   Decimal?                         @default(0.00) @db.Decimal(14, 2)
  discount                       Decimal?                         @default(0.00) @db.Decimal(12, 2)
  cgst_percent                   Decimal?                         @default(0.00) @db.Decimal(5, 2)
  cgst_amount                    Decimal?                         @default(0.00) @db.Decimal(12, 2)
  sgst_percent                   Decimal?                         @default(0.00) @db.Decimal(5, 2)
  sgst_amount                    Decimal?                         @default(0.00) @db.Decimal(12, 2)
  igst_percent                   Decimal?                         @default(0.00) @db.Decimal(5, 2)
  igst_amount                    Decimal?                         @default(0.00) @db.Decimal(12, 2)
  delivery_date                  DateTime?                        @db.Date
  purchase_req_no                String?                          @db.VarChar(120)
  customer_reference             String?                          @db.VarChar(120)
  customer_po_item_subassemblies customer_po_item_subassemblies[]
  customer_pos                   customer_pos                     @relation(fields: [customer_po_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_po_items_ibfk_1")

  @@index([customer_po_id], map: "customer_po_id")
}

model customer_pos {
  id                       Int                  @id @default(autoincrement())
  company_id               Int
  project_name             String?              @db.VarChar(255)
  po_number                String?              @db.VarChar(100)
  po_date                  DateTime?            @db.Date
  po_version               String?              @db.VarChar(20)
  order_type               String?              @db.VarChar(40)
  plant                    String?              @db.VarChar(120)
  currency                 String?              @default("INR") @db.VarChar(10)
  payment_terms            String?              @db.VarChar(255)
  credit_days              Int?
  freight_terms            String?              @db.VarChar(255)
  packing_forwarding       String?              @db.VarChar(255)
  insurance_terms          String?              @db.VarChar(255)
  delivery_terms           String?              @db.VarChar(255)
  status                   customer_pos_status? @default(DRAFT)
  pdf_path                 String?              @db.VarChar(500)
  subtotal                 Decimal?             @default(0.00) @db.Decimal(14, 2)
  tax_total                Decimal?             @default(0.00) @db.Decimal(14, 2)
  net_total                Decimal?             @default(0.00) @db.Decimal(14, 2)
  remarks                  String?              @db.Text
  terms_and_conditions     String?              @db.Text
  special_notes            String?              @db.Text
  inspection_clause        String?              @db.VarChar(50)
  test_certificate         String?              @db.VarChar(50)
  requesting_department_id Int?
  created_at               DateTime?            @default(now()) @db.Timestamp(0)
  customer_po_items        customer_po_items[]
  companies                companies            @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_pos_ibfk_1")
  departments              departments?         @relation(fields: [requesting_department_id], references: [id], onUpdate: NoAction, map: "customer_pos_ibfk_2")
  sales_orders             sales_orders[]

  @@index([company_id], map: "company_id")
  @@index([requesting_department_id], map: "requesting_department_id")
}

model delivery_challan_items {
  id                Int               @id @default(autoincrement())
  challan_id        Int
  item_code         String?           @db.VarChar(120)
  description       String?           @db.Text
  quantity          Decimal           @db.Decimal(12, 3)
  unit              String?           @db.VarChar(20)
  weight            Decimal?          @db.Decimal(12, 3)
  delivery_challans delivery_challans @relation(fields: [challan_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "delivery_challan_items_ibfk_1")

  @@index([challan_id], map: "challan_id")
}

model delivery_challans {
  id                     Int                                @id @default(autoincrement())
  challan_number         String                             @unique(map: "challan_number") @db.VarChar(50)
  shipment_id            Int
  customer_id            Int
  delivery_status        delivery_challans_delivery_status? @default(DRAFT)
  dispatch_time          DateTime?                          @db.Timestamp(0)
  delivery_time          DateTime?                          @db.Timestamp(0)
  receiver_name          String?                            @db.VarChar(120)
  receiver_mobile        String?                            @db.VarChar(30)
  signature_file         String?                            @db.VarChar(500)
  photo_proof            String?                            @db.VarChar(500)
  created_at             DateTime?                          @default(now()) @db.Timestamp(0)
  updated_at             DateTime?                          @default(now()) @db.Timestamp(0)
  delivery_challan_items delivery_challan_items[]
  shipment_orders        shipment_orders                    @relation(fields: [shipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "delivery_challans_ibfk_1")
  companies              companies                          @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "delivery_challans_ibfk_2")

  @@index([customer_id], map: "customer_id")
  @@index([shipment_id], map: "shipment_id")
}

model departments {
  id           Int                 @id @default(autoincrement())
  name         String              @unique(map: "name") @db.VarChar(120)
  code         String              @unique(map: "code") @db.VarChar(50)
  description  String?             @db.Text
  status       departments_status? @default(ACTIVE)
  created_at   DateTime?           @default(now()) @db.Timestamp(0)
  customer_pos customer_pos[]
  roles        roles[]
  users        users[]
}

model design_orders {
  id                  Int                   @id @default(autoincrement())
  design_order_number String                @unique(map: "design_order_number") @db.VarChar(100)
  sales_order_id      Int
  status              design_orders_status? @default(DRAFT)
  start_date          DateTime?             @db.Timestamp(0)
  completion_date     DateTime?             @db.Timestamp(0)
  created_at          DateTime?             @default(now()) @db.Timestamp(0)
  updated_at          DateTime?             @default(now()) @db.Timestamp(0)
  sales_orders        sales_orders          @relation(fields: [sales_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "design_orders_ibfk_1")

  @@index([sales_order_id], map: "sales_order_id")
}

model design_rejections {
  id             Int          @id @default(autoincrement())
  sales_order_id Int
  reason         String?      @db.Text
  created_at     DateTime?    @default(now()) @db.Timestamp(0)
  sales_orders   sales_orders @relation(fields: [sales_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "design_rejections_ibfk_1")

  @@index([sales_order_id], map: "sales_order_id")
}

model document_access_logs {
  id            Int       @id @default(autoincrement())
  user_id       Int
  document_type String?   @db.VarChar(50)
  document_id   Int?
  action        String?   @db.VarChar(50)
  status        String?   @db.VarChar(50)
  timestamp     DateTime? @default(now()) @db.Timestamp(0)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "document_access_logs_ibfk_1")

  @@index([user_id], map: "user_id")
}

model grn_excess_approvals {
  id               Int       @id @default(autoincrement())
  grn_item_id      Int
  excess_qty       Decimal   @db.Decimal(12, 3)
  status           String?   @default("PENDING") @db.VarChar(50)
  approval_notes   String?   @db.Text
  rejection_reason String?   @db.Text
  approved_at      DateTime? @db.Timestamp(0)
  rejected_at      DateTime? @db.Timestamp(0)
  created_at       DateTime? @default(now()) @db.Timestamp(0)
  updated_at       DateTime? @default(now()) @db.Timestamp(0)
  grn_items        grn_items @relation(fields: [grn_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "grn_excess_approvals_ibfk_1")

  @@index([grn_item_id], map: "grn_item_id")
  @@index([status], map: "idx_grn_excess_status")
}

model grn_items {
  id                    Int                          @id @default(autoincrement())
  grn_id                Int
  po_item_id            Int
  po_qty                Decimal?                     @default(0.000) @db.Decimal(12, 3)
  received_qty          Decimal?                     @default(0.000) @db.Decimal(12, 3)
  accepted_qty          Decimal?                     @default(0.000) @db.Decimal(12, 3)
  rejected_qty          Decimal?                     @default(0.000) @db.Decimal(12, 3)
  shortage_qty          Decimal?                     @default(0.000) @db.Decimal(12, 3)
  overage_qty           Decimal?                     @default(0.000) @db.Decimal(12, 3)
  status                String?                      @db.VarChar(50)
  remarks               String?                      @db.Text
  is_approved           Boolean?                     @default(false)
  created_at            DateTime?                    @default(now()) @db.Timestamp(0)
  allocated_qty         Decimal?                     @default(0.000) @db.Decimal(12, 3)
  allocation_status     grn_items_allocation_status? @default(PENDING)
  warehouse_id          Int?
  length                Decimal?                     @default(0.0000) @db.Decimal(12, 4)
  width                 Decimal?                     @default(0.0000) @db.Decimal(12, 4)
  thickness             Decimal?                     @default(0.0000) @db.Decimal(12, 4)
  diameter              Decimal?                     @default(0.0000) @db.Decimal(12, 4)
  outer_diameter        Decimal?                     @default(0.0000) @db.Decimal(12, 4)
  density               Decimal?                     @default(0.0000) @db.Decimal(12, 4)
  weight_per_unit       Decimal?                     @default(0.0000) @db.Decimal(12, 4)
  uom                   String?                      @db.VarChar(20)
  grn_excess_approvals  grn_excess_approvals[]
  warehouses            warehouses?                  @relation(fields: [warehouse_id], references: [id], onUpdate: NoAction, map: "fk_grn_items_warehouse")
  grns                  grns                         @relation(fields: [grn_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "grn_items_ibfk_1")
  qc_inspection_items   qc_inspection_items[]
  warehouse_allocations warehouse_allocations[]

  @@index([warehouse_id], map: "fk_grn_items_warehouse")
  @@index([grn_id], map: "grn_id")
  @@index([status], map: "idx_grn_items_status")
}

model grns {
  id                Int              @id @default(autoincrement())
  po_number         String           @db.VarChar(100)
  grn_date          DateTime         @db.Date
  received_quantity Decimal?         @default(0.000) @db.Decimal(12, 3)
  status            grns_status?     @default(PENDING)
  notes             String?          @db.Text
  created_at        DateTime?        @default(now()) @db.Timestamp(0)
  updated_at        DateTime?        @default(now()) @db.Timestamp(0)
  po_receipt_id     Int?
  grn_items         grn_items[]
  qc_inspections    qc_inspections[]
  stock_entries     stock_entries[]

  @@index([po_number], map: "idx_po_number")
  @@index([po_number], map: "idx_po_number_grn")
  @@index([status], map: "idx_status")
}

model inventory {
  id                 Int                  @id @default(autoincrement())
  item_code          String               @unique(map: "item_code") @db.VarChar(100)
  description        String?              @db.VarChar(255)
  unit               String?              @db.VarChar(50)
  category_id        Int?
  stock_on_hand      Int?                 @default(0)
  reorder_level      Int?                 @default(0)
  reorder_qty        Int?                 @default(0)
  created_at         DateTime?            @default(now()) @db.Timestamp(0)
  updated_at         DateTime?            @default(now()) @db.Timestamp(0)
  inventory_postings inventory_postings[]

  @@index([item_code], map: "idx_item_code")
  @@index([stock_on_hand], map: "idx_stock")
}

model inventory_dashboard {
  id                  Int       @id @default(autoincrement())
  total_stock_on_hand Int?      @default(0)
  today_inward_qty    Int?      @default(0)
  grn_count           Int?      @default(0)
  pending_po_qty      Int?      @default(0)
  updated_at          DateTime? @default(now()) @db.Timestamp(0)
}

model inventory_postings {
  id             Int       @id @default(autoincrement())
  inventory_id   Int
  posting_type   String    @db.VarChar(50)
  quantity       Int
  reference_type String?   @db.VarChar(50)
  reference_id   Int?
  remarks        String?   @db.Text
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
  inventory      inventory @relation(fields: [inventory_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "inventory_postings_ibfk_1")

  @@index([created_at], map: "idx_created_at")
  @@index([inventory_id], map: "idx_inventory_id")
  @@index([posting_type], map: "idx_inventory_postings_type")
  @@index([posting_type], map: "idx_posting_type")
  @@index([reference_type, reference_id], map: "idx_reference")
}

model inward_challan_items {
  id                Int             @id @default(autoincrement())
  inward_challan_id Int
  item_code         String?         @db.VarChar(120)
  received_qty      Decimal?        @db.Decimal(12, 3)
